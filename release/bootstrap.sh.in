#!/bin/sh
set -eu

PROGRAM=beroka-governance-bootstrap
REMOTE_URL=https://github.com/beroka-vn/beroka-ai-governance.git
RELEASE_VERSION='@RELEASE_VERSION@'
RELEASE_COMMIT='@RELEASE_COMMIT@'

die() {
  code=$1
  shift
  printf '%s\n' "Result: $code" >&2
  [ "$#" -eq 0 ] || printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    "Usage: $PROGRAM --client codex|claude|cursor [--upgrade] [--non-interactive]"
}

run_as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    return 1
  fi
}

ensure_jq() {
  command -v jq >/dev/null 2>&1 && return
  [ "$non_interactive" -eq 0 ] ||
    die DEPENDENCY_MISSING 'Remediation: install jq'
  [ -t 1 ] && ( : </dev/tty ) 2>/dev/null ||
    die TTY_REQUIRED \
      "Retry with: $PROGRAM --client $client --non-interactive"

  installer=
  for candidate in apt-get dnf brew; do
    if command -v "$candidate" >/dev/null 2>&1; then
      installer=$candidate
      break
    fi
  done
  [ -n "$installer" ] ||
    die DEPENDENCY_MISSING 'Remediation: install jq'

  printf 'Missing dependency: jq. Install with %s (may request sudo)? [y/N] ' \
    "$installer" >/dev/tty
  IFS= read -r answer </dev/tty || answer=
  case "$answer" in
    y|Y|yes|YES) ;;
    *) die DEPENDENCY_MISSING 'Remediation: install jq' ;;
  esac

  case "$installer" in
    apt-get)
      run_as_root apt-get update &&
        run_as_root apt-get install -y jq ||
        die DEPENDENCY_MISSING 'Remediation: install jq'
      ;;
    dnf)
      run_as_root dnf install -y jq ||
        die DEPENDENCY_MISSING 'Remediation: install jq'
      ;;
    brew)
      brew install jq ||
        die DEPENDENCY_MISSING 'Remediation: install jq'
      ;;
  esac
  command -v jq >/dev/null 2>&1 ||
    die DEPENDENCY_MISSING 'Remediation: install jq'
}

client=
non_interactive=0
upgrade=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --client)
      [ -z "$client" ] && [ "$#" -ge 2 ] || {
        usage >&2
        exit 2
      }
      case "$2" in
        codex|claude|cursor) client=$2 ;;
        *) usage >&2; exit 2 ;;
      esac
      shift 2
      ;;
    --non-interactive)
      [ "$non_interactive" -eq 0 ] || {
        usage >&2
        exit 2
      }
      non_interactive=1
      shift
      ;;
    --upgrade)
      [ "$upgrade" -eq 0 ] || {
        usage >&2
        exit 2
      }
      upgrade=1
      shift
      ;;
    *) usage >&2; exit 2 ;;
  esac
done
[ -n "$client" ] || {
  usage >&2
  exit 2
}

printf '%s\n' "$RELEASE_VERSION" |
  grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$' ||
  die RELEASE_VERIFICATION_FAILED 'Invalid embedded release version'
printf '%s\n' "$RELEASE_COMMIT" |
  grep -Eq '^[0-9a-f]{40}$' ||
  die RELEASE_VERIFICATION_FAILED 'Invalid embedded release commit'

bootstrap_root=$(mktemp -d \
  "${TMPDIR:-/tmp}/beroka-governance-bootstrap.XXXXXX") ||
  die GOVERNANCE_NOT_READY 'Cannot create the bootstrap directory'
trap 'rm -rf "$bootstrap_root"' EXIT HUP INT TERM

git clone --quiet --depth 1 --single-branch \
  --branch "$RELEASE_VERSION" \
  "$REMOTE_URL" "$bootstrap_root/repo" >/dev/null 2>&1 ||
  die RELEASE_VERIFICATION_FAILED 'Cannot clone the embedded release tag'

tag_type=$(git -C "$bootstrap_root/repo" \
  cat-file -t "refs/tags/$RELEASE_VERSION" 2>/dev/null || :)
actual_commit=$(git -C "$bootstrap_root/repo" \
  rev-parse "refs/tags/$RELEASE_VERSION^{commit}" 2>/dev/null || :)
[ "$tag_type" = tag ] && [ "$actual_commit" = "$RELEASE_COMMIT" ] ||
  die RELEASE_VERIFICATION_FAILED \
    'The release tag does not match the embedded commit'
checked_out_commit=$(git -C "$bootstrap_root/repo" \
  rev-parse HEAD 2>/dev/null || :)
[ "$checked_out_commit" = "$RELEASE_COMMIT" ] ||
  die RELEASE_VERIFICATION_FAILED \
    'The cloned release does not match the embedded commit'

ensure_jq

cli=$bootstrap_root/repo/bin/beroka-governance
set -- bootstrap \
  --client "$client" \
  --version "$RELEASE_VERSION"
[ "$upgrade" -eq 0 ] || set -- "$@" --upgrade
[ "$non_interactive" -eq 0 ] || set -- "$@" --non-interactive
if [ "$non_interactive" -eq 0 ]; then
  [ -t 1 ] && ( : </dev/tty ) 2>/dev/null ||
    die TTY_REQUIRED \
      "Retry with: $PROGRAM --client $client --non-interactive"
  sh "$cli" "$@" </dev/tty
else
  sh "$cli" "$@"
fi
